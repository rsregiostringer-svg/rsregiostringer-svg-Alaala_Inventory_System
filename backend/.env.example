# ============================================================
# ALAALA FUNERAL HOMES - BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Do NOT commit .env files containing real production secrets.

SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
DEBUG=False

# Production Database (Neon, Supabase, Render, Railway PostgreSQL)
# Example: postgresql://username:password@ep-sample-1234.us-east-2.aws.neon.tech/alaala_db?sslmode=require
DATABASE_URL=

# Hostnames allowed to access Django
# In production, specify your backend domain (e.g., api.alaalafuneralhomes.com, your-backend.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.fly.dev

# CORS: Frontend domains allowed to make cross-origin requests
# Production MUST use your Vercel frontend URL (e.g., https://alaala-management.vercel.app)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# CSRF: Trusted origins for state-changing POST/PUT requests
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com,http://localhost:5173

# Frontend Application URL
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Signing Secret (Defaults to SECRET_KEY if left blank)
JWT_SECRET_KEY=

# Cloud Storage Configuration (Cloudinary / S3 / R2)
# Production maintenance photos should use cloud storage
MEDIA_STORAGE=cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Realtime Channels / Redis (Optional, falls back to InMemoryChannelLayer if blank)
# Example: rediss://default:password@your-redis-host:6379
REDIS_URL=
